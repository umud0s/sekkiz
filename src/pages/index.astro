---
import Base from '../layouts/Base.astro';

// k: ulduzun hansı guşəsi (0 = yuxarı, saat əqrəbi istiqamətində)
const cards = [
  { k: 7, title: 'Dövlət rəmzləri', desc: 'Bayraq, gerb və himn: tarixi və mənası', href: '/dovlet-remzleri/', d: ['M5 21V4', 'M5 4h12l-2.5 4.5L17 13H5'] },
  { k: 0, title: 'Xəritə', desc: 'Şəhərlər, rayonlar, dağlar və çaylar', href: '/xerite/', d: ['M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z', 'M9 4v14', 'M15 6v14'] },
  { k: 1, title: 'Tarix', desc: 'Qədim dövrdən bu günə qədər əsas hadisələr', href: '/tarix/', d: ['M3 21h18', 'M3 9.5 12 4l9 5.5z', 'M6 21v-9M10 21v-9M14 21v-9M18 21v-9'] },
  { k: 6, title: 'İnteraktiv Fəxri xiyaban', desc: 'Xalqımızın görkəmli şəxsiyyətlərinin xatirə məkanı', href: '', d: ['M4 21h16', 'M8.5 21V9l3.5-5 3.5 5v12', 'M10.5 12.5h3', 'M5 21v-3.5a1.5 1.5 0 0 1 3 0V21', 'M16 21v-3.5a1.5 1.5 0 0 1 3 0V21'] },
  { k: 2, title: 'Lüğət', desc: 'Sözün mənası, yazılışı və işlənməsi', href: '/luget/', d: ['M3 5.5c3-1.2 6-1 9 1 3-2 6-2.2 9-1v13.5c-3-1.2-6-1-9 1-3-2-6-2.2-9-1z', 'M12 6.5V20'] },
  { k: 5, title: 'Atalar sözləri', desc: 'Xalq hikməti və hər birinin izahı', href: '/atalar-sozleri/', d: ['M4 5h16v11H10l-6 4z', 'M8.5 9.5h7', 'M8.5 12.5h4'] },
  { k: 4, title: 'Nağıllar', desc: 'Nənələrimizin danışdığı nağıllar', href: '/nagillar/', d: ['M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z', 'M17 3v3M15.5 4.5h3'] },
  { k: 3, title: 'Bayramlar və ənənələr', desc: 'Novruzdan el adətlərinə qədər', href: '', d: ['M12 3c.8 3 5 5.2 5 10a5 5 0 0 1-10 0c0-3 2-4.2 2.2-6.5 1 .9 1.8 2 1.8 3.5.4-2.8.2-5 1-7z', 'M12 21v-3'] },
];
// Ulduzun hər guşəsi iki üzlüdür: a (açıq), b (tünd)
const R = 100, r = 70.71, q = 29.29;
const tips = [[0,-R],[r,-r],[R,0],[r,r],[0,R],[-r,r],[-R,0],[-r,-r]];
const sides = [
  [[-q,-r],[q,-r]], [[q,-r],[r,-q]], [[r,-q],[r,q]], [[r,q],[q,r]],
  [[q,r],[-q,r]], [[-q,r],[-r,q]], [[-r,q],[-r,-q]], [[-r,-q],[-q,-r]],
];
const facets = tips.flatMap((t, k) => [
  { k, side: 'a', pts: `${t[0]},${t[1]} ${sides[k][0][0]},${sides[k][0][1]} 0,0` },
  { k, side: 'b', pts: `${t[0]},${t[1]} ${sides[k][1][0]},${sides[k][1][1]} 0,0` },
]);
---
<Base current="home">
  <section class="wrap hero">
    <figure>
      <svg width="40" height="32" viewBox="0 0 40 32" aria-hidden="true"><path d="M0 32V19C0 8 6 2 16 0l2 4c-6 2-9 6-9 11h8v17zM22 32V19c0-11 6-17 16-19l2 4c-6 2-9 6-9 11h8v17z" fill="#0A6E99" fill-opacity="0.35"/></svg>
      <blockquote>
        <p>“Azərbaycan dilinin saflığının qorunması hər bir Azərbaycan vətəndaşının işi olmalıdır.”</p>
        <p>“Azərbaycanda mənəvi dəyərlərə, ənənələrə, həyat tərzimizə sadiqlik başlıca tendensiyadır.”</p>
      </blockquote>
      <figcaption>
        <a class="cap" href="https://president.az/" target="_blank" rel="noopener" aria-label="İlham Əliyev, Azərbaycan Respublikasının Prezidenti: rəsmi sayt yeni pəncərədə açılır">
          <img src="/img/gerb-sm.webp" width="40" height="44" alt="" />
          <span class="cap-t"><b>İlham Əliyev</b><span>Azərbaycan Respublikasının Prezidenti</span></span>
          <svg class="cap-go" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
        </a>
      </figcaption>
    </figure>
  </section>

  <section class="wrap" aria-label="Bölmələr" style="padding-bottom:72px">
    <h1 class="sr-only">Səkkizguşə: Azərbaycan dili, tarixi və milli irsi</h1>
    <div class="home-grid">
      {cards.map((c, i) => (
        <>
          {i === 4 && (
            <div class="star-cell">
              <svg class="star" width="190" height="190" viewBox="-108 -108 216 216" role="img" aria-label="Səkkizguşəli ulduz: hər guşə bir bölmədir">
                <g stroke="#064A69" stroke-width="1.2" stroke-linejoin="round">
                  {facets.map((f) => <polygon points={f.pts} data-k={f.k} class={`f-${f.side}`} />)}
                </g>
                <polygon points="0,-100 29.29,-70.71 70.71,-70.71 70.71,-29.29 100,0 70.71,29.29 70.71,70.71 29.29,70.71 0,100 -29.29,70.71 -70.71,70.71 -70.71,29.29 -100,0 -70.71,-29.29 -70.71,-70.71 -29.29,-70.71" fill="none" stroke="#053E58" stroke-width="3" stroke-linejoin="round" />
              </svg>
              <span class="star-cap" aria-live="polite">Səkkiz guşə, səkkiz bölmə</span>
            </div>
          )}
          <div class="float" style={`animation-delay:${-i * 0.9}s`}>
            {c.href ? (
              <a class="hcard" href={c.href} data-k={c.k} data-title={c.title}>
                <span class="hicon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{c.d.map((d) => <path d={d} />)}</svg></span>
                <h2>{c.title}</h2>
                <p class="hdesc">{c.desc}</p>
              </a>
            ) : (
              <div class="hcard soon" aria-disabled="true">
                <span class="hicon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{c.d.map((d) => <path d={d} />)}</svg></span>
                <h2>{c.title}</h2>
                <span class="soon-badge">Tezliklə</span>
                <p class="hdesc">{c.desc}</p>
              </div>
            )}
          </div>
        </>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero{display:flex;justify-content:center;padding-top:12px;padding-bottom:40px}
  .hero figure{position:relative;overflow:hidden;margin:0;width:100%;max-width:1080px;padding:40px 48px 36px;border-radius:28px;background:linear-gradient(135deg,#FFFFFF 0%,#EEF6FA 100%);border:1px solid var(--line);box-shadow:var(--shadow);display:flex;flex-direction:column;align-items:center;gap:18px;text-align:center}
  .hero figure::before{content:'';position:absolute;inset:0 0 auto 0;height:6px;background:linear-gradient(90deg,#509E2F 0 33.3%,#EF3340 33.3% 66.6%,#00B5E2 66.6%)}
  .hero blockquote{margin:0;max-width:860px;display:flex;flex-direction:column;gap:14px}
  .hero blockquote p{margin:0;font-size:30px;font-weight:500;line-height:1.3}
  .cap{display:flex;align-items:center;gap:12px;padding:8px 18px 8px 10px;border-radius:999px;background:var(--accent);color:#FFFFFF;text-align:left;text-decoration:none;box-shadow:0 10px 22px -12px rgba(6,74,105,.7);transition:background .25s,transform .25s,box-shadow .25s}
  .cap:hover,.cap:focus-visible{background:var(--accent-dark);color:#FFFFFF;transform:translateY(-2px);box-shadow:0 14px 26px -12px rgba(6,74,105,.8)}
  .cap-go{flex:none;margin-left:4px;opacity:.8;transition:transform .25s}
  .cap:hover .cap-go{transform:translate(2px,-2px)}
  .hero figcaption img{flex:none;width:40px;height:auto;padding:4px;border-radius:50%;background:#FFFFFF}
  .cap-t{display:flex;flex-direction:column;line-height:1.2}
  .cap-t b{font-size:17px;font-weight:600}
  .cap-t span{font-size:14px;font-weight:500;opacity:.85}
  .home-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;max-width:1080px;margin:0 auto}
  .hcard{display:flex;flex-direction:column;gap:14px;height:100%;padding:28px;border-radius:18px;background:#FFFFFF;color:var(--ink);text-decoration:none;border:1px solid var(--line);box-shadow:var(--shadow);transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s}
  a.hcard:hover,a.hcard:focus-visible{transform:translateY(-8px);box-shadow:var(--shadow-hi);color:var(--ink)}
  .hcard h2{margin:6px 0 0;font-size:22px;font-weight:500;line-height:1.25}
  .hdesc{margin:0;font-size:17px;line-height:1.45;color:var(--muted)}
  .hicon{display:flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:14px;background:#E6F0F6;color:var(--accent);transition:background .3s,color .3s}
  a.hcard:hover .hicon{background:var(--accent);color:#FFFFFF}
  .soon{box-shadow:0 1px 2px rgba(10,50,80,.06),0 8px 20px -12px rgba(10,50,80,.18)}
  .soon h2,.soon .hdesc,.soon .hicon{opacity:.6}
  .soon-badge{align-self:flex-start;padding:4px 12px;border-radius:999px;background:#FFF1CC;color:#7A5300;font-size:14px;font-weight:600}
  .float{animation:float 7s ease-in-out infinite alternate}
  @keyframes float{from{transform:translateY(0)}to{transform:translateY(-5px)}}
  .star-cell{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;padding:12px 0}
  .star{filter:drop-shadow(0 14px 18px rgba(6,60,95,.35)) drop-shadow(0 2px 3px rgba(6,60,95,.3))}
  .star polygon{transition:fill .3s}
  .f-a{fill:#2A93C4}.f-b{fill:#08608A}
  .f-a.hot{fill:#E8545F}.f-b.hot{fill:#B7202D}
  .star-cap{padding:8px 16px;border-radius:999px;background:#FFFFFF;border:1px solid var(--line);box-shadow:0 6px 14px -8px rgba(10,50,80,.35);font-size:15px;font-weight:500;color:#1F3344;text-align:center}
  @media (max-width:760px){
    .hero{padding-top:4px;padding-bottom:28px}
    .hero figure{padding:28px 20px 24px;border-radius:22px}
    .hero blockquote p{font-size:22px}
    .home-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
    .star-cell{order:-1;grid-column:1 / -1}
    .hcard{padding:20px}
    .hdesc{display:none}
  }
</style>

<script>
  // Kartın üzərinə gələndə ulduzun uyğun guşəsi qırmızı olur
  const cap = document.querySelector('.star-cap');
  const def = cap?.textContent ?? '';
  const facets = [...document.querySelectorAll('.star polygon[data-k]')];
  const set = (k, title) => {
    facets.forEach((p) => p.classList.toggle('hot', k !== null && p.dataset.k === k));
    if (cap) cap.textContent = title ?? def;
  };
  document.querySelectorAll('a.hcard').forEach((a) => {
    const on = () => set(a.dataset.k, a.dataset.title);
    const off = () => set(null, null);
    a.addEventListener('mouseenter', on); a.addEventListener('focus', on);
    a.addEventListener('mouseleave', off); a.addEventListener('blur', off);
  });
</script>
