---
import Base from '../layouts/Base.astro';
---
<Base title="Səhifə tapılmadı">
  <div class="wrap section" style="align-items:center;text-align:center;padding-top:8px">
   <div class="card" style="display:flex;flex-direction:column;align-items:center;gap:16px;padding:40px 32px;max-width:640px;width:100%">
    <p style="margin:0;font-size:88px;font-weight:600;color:var(--accent);line-height:1">404</p>
    <h1 class="page-title" style="font-size:36px">Bu səhifə tapılmadı</h1>
    <p class="lead">Ünvan səhv yazılıb və ya səhifə köçürülüb. Ana səhifədən axtardığınızı tapa bilərsiniz.</p>
    <a class="btn btn-p" href="/">Ana səhifəyə qayıt</a>
   </div>
  </div>
</Base>
