---
import Base from '../../layouts/Base.astro';
import Reytinq from '../../components/Reytinq.astro';
import { PILLELER, QORUNAN, SUALLAR } from '../../data/diyar.js';
import KENDLER from '../../data/kendler.json';
const KENDSAY = Object.values(KENDLER).flat().length;
---
<Base title="Kim diyarşünas olmaq istəyir?" description="Azərbaycanın kəndləri, qalaları, abidələri, su anbarları, məscidləri və dahilərin doğulduğu yerlər haqqında 15 suallıq oyun. Pul yox, Azərbaycanın xəzinəsindən hədiyyələr.">
  <div class="wrap section">
    <section class="stack">
      <nav class="crumbs" aria-label="Yol"><a href="/">Ana səhifə</a> <span aria-hidden="true">/</span> <a href="/xerite/">Xəritə</a> <span aria-hidden="true">/</span> Diyarşünas</nav>
      <h1 class="page-title">Kim diyarşünas olmaq istəyir?</h1>
      <p class="lead">15 sual, hər sualda 4 variant. Kəndlər, qalalar, abidələr, göllər, milli parklar, təbii sərvətlər, köhnə adlar, tarixi hadisələr, yerli məhsullar, qədim məscidlər və dahilərin doğulduğu yerlər. Hər doğru cavab səni xəzinəyə bir pillə yaxınlaşdırır.</p>
    </section>

    <div class="dy-tabs">
      <button type="button" class="chip" data-tab="oyun" aria-pressed="true">Oyun</button>
      <button type="button" class="chip" data-tab="xezine" aria-pressed="false">Xəzinəm <span class="n" id="xn">0</span></button>
      <button type="button" class="chip" data-tab="reyt" aria-pressed="false">Reytinq</button>
    </div>

    <div class="dy" id="t-oyun">
      <div class="dy-stage">
        <div class="dy-panel" id="intro">
          <h2>Qaydalar</h2>
          <ol>
            <li>Oyunda <b>15 sual</b> var. Hər sualın 4 variantı, yalnız biri düzgündür.</li>
            <li>Suallar tədricən çətinləşir: ilk 5 sual <b>asan</b>, növbəti 5 sual <b>orta</b>, son 5 sual <b>çətindir</b>.</li>
            <li>Vaxt məhduddur: asan suallara <b>20</b>, orta suallara <b>30</b>, çətin suallara <b>40 saniyə</b> verilir. Vaxt bitsə, cavab səhv sayılır.</li>
            <li>Mükafat pul deyil: hər pillədə Azərbaycanın xəzinəsindən bir hədiyyə qazanırsan. 15-ci pillədə səni <b>Qızıl Səkkizguşə</b> və "Böyük diyarşünas" adı gözləyir.</li>
            <li><b>5-ci</b> və <b>10-cu</b> pillələr qorunan pillələrdir. Səhv cavab versən oyun bitir, amma son keçdiyin qorunan pillənin hədiyyəsi səndə qalır.</li>
            <li>Cavabdan əmin deyilsənsə, <b>"Dayan və hədiyyəni götür"</b> düyməsi ilə qazandığını saxlayıb oyunu bitirə bilərsən.</li>
            <li>İki <b>kömək haqqın</b> var, hər birindən bir dəfə istifadə edə bilərsən: <b>İpucu</b> düzgün cavab haqqında məlumat verir, <b>50:50</b> isə iki səhv cavabı silir.</li>
          </ol>
          <p class="muted">Qazandığın hədiyyələr "Xəzinəm" bölməsində toplanır.</p>
          <button type="button" class="btn dy-go" id="start">Oyuna başla</button>
        </div>

        <div class="dy-panel" id="play" hidden>
          <div class="dy-top">
            <span class="dy-cat" id="cat"></span>
            <span class="dy-lvl" id="lvl"></span>
            <span class="dy-num"><b id="qn">1</b> / 15</span>
          </div>
          <div class="dy-life" role="group" aria-label="Kömək haqların">
            <span class="dy-life-t">Kömək haqların</span>
            <button type="button" class="dy-ll" id="help" aria-label="İpucu: ərazi haqqında məlumat">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.7.6 1.1 1.3 1.1 2.2h5c0-.9.4-1.6 1.1-2.2A6 6 0 0 0 12 3Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>İpucu</span>
            </button>
            <button type="button" class="dy-ll" id="half" aria-label="50:50: iki səhv cavabı sil">
              <b>50:50</b>
            </button>
          </div>
          <div class="dy-timer" aria-live="off"><div class="dy-bar"><i id="bar"></i></div><span class="dy-sec"><b id="tm">20</b> san</span></div>
          <p class="dy-q" id="q"></p>
          <div class="dy-ans" id="ans"></div>
          <div class="dy-hint" id="hint" hidden></div>
          <div class="dy-acts">
            <button type="button" class="btn dy-stop" id="stop">Dayan və hədiyyəni götür</button>
          </div>
        </div>

        <div class="dy-panel" id="done" hidden>
          <div class="dy-res" id="res"></div>
          <button type="button" class="btn dy-go" id="again">Yenidən oyna</button>
        </div>
      </div>

      <ol class="dy-ladder" id="ladder" aria-label="Mükafat pillələri">
        {PILLELER.map(([t, d], i) => <li data-i={i} class={QORUNAN.includes(i) ? 'safe' : undefined}><span class="no">{i + 1}</span><span class="t">{t}<small>{d}</small></span></li>).reverse()}
      </ol>
    </div>

    <section id="t-xezine" hidden>
      <div class="xz" id="xz"></div>
      <div class="dy-stat" id="stat"></div>
      <p class="muted xz-note">Xəzinə bu brauzerdə saxlanılır. Reytinqdə isə hesabının ən yüksək pilləsi görünür.</p>
    </section>
    <section id="t-reyt" class="card dy-rt" hidden>
      <h2>Ümumi reytinq</h2>
      <p class="muted">Oyunçular bir oyunda verdikləri ən çox düz cavab sayına görə sıralanır. Bərabər olanda o sayda düz cavaba daha tez çatan öndədir. Vaxt yalnız suallara fikirləşmə müddətidir.</p>
      <Reytinq oyun="diyar" />
    </section>
    <p class="muted dy-src">Suallar bazası: {SUALLAR.length} seçilmiş sual və {KENDSAY} kənd, qəsəbə. Kənd və qəsəbələrin hansı rayonda olduğu Dövlət Statistika Komitəsinin "İnzibati ərazi bölgüsü təsnifatı" (2024) üzrə verilir.</p>
  </div>
</Base>

<style is:global>
  .dy-tabs{display:flex;gap:8px;flex-wrap:wrap}
  .dy{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:24px;align-items:start}
  .dy[hidden],#t-xezine[hidden],#t-reyt[hidden],.dy-panel[hidden]{display:none}
  .dy-rt{padding:24px 26px}
  .dy-rt h2{margin:0 0 4px}
  .dy-rt > p{margin:0 0 12px}
  .dy-stage{border-radius:26px;padding:28px;background:radial-gradient(circle at 50% 0%,#1F4C8C 0%,#10224A 60%,#0A1530 100%);color:#FFFFFF;box-shadow:var(--shadow-hi);min-height:460px}
  .dy-panel{display:flex;flex-direction:column;gap:18px}
  .dy-panel h2{margin:0;font-size:28px;font-weight:500}
  .dy-panel ol{margin:0;padding-left:22px;display:flex;flex-direction:column;gap:10px;font-size:17px;line-height:1.5;color:#E6EEF7}
  .dy-panel .muted{color:#AFC2D8;margin:0}
  .dy-go{align-self:flex-start;min-height:54px;padding:0 30px;font-size:18px;background:linear-gradient(#F6C451,#D99A1E);color:#2A1A00;box-shadow:0 8px 20px -8px rgba(246,196,81,.8)}
  .dy-go:hover{color:#2A1A00}
  .dy-top{display:flex;justify-content:space-between;align-items:center;gap:10px}
  .dy-cat{padding:6px 14px;border-radius:999px;background:rgba(255,255,255,.12);font-size:14px;font-weight:600;letter-spacing:.4px}
  .dy-lvl{margin-right:auto;margin-left:8px;padding:6px 12px;border-radius:999px;font-size:13px;font-weight:600}
  .dy-lvl.l1{background:#2E7D4A}.dy-lvl.l2{background:#B07A12}.dy-lvl.l3{background:#B0303A}
  .dy-timer{display:flex;align-items:center;gap:12px}
  .dy-bar{flex:1;height:10px;border-radius:999px;background:rgba(255,255,255,.12);overflow:hidden}
  .dy-bar i{display:block;height:100%;width:100%;border-radius:999px;background:linear-gradient(90deg,#3DBA5A,#F6C451);transform-origin:left;transition:transform .25s linear,background .3s}
  .dy-bar i.low{background:linear-gradient(90deg,#E0454F,#F6A623)}
  .dy-sec{min-width:70px;text-align:right;font-size:15px;color:#AFC2D8}
  .dy-sec b{font-size:22px;color:#FFFFFF;font-variant-numeric:tabular-nums}
  .dy-sec.low b{color:#FF7A82}
  .dy-num{font-size:15px;color:#AFC2D8}.dy-num b{font-size:20px;color:#F6C451}
  .dy-q{margin:6px 0;padding:22px 26px;border-radius:22px;border:2px solid #4B78B8;background:linear-gradient(#183467,#0F2348);font-size:24px;line-height:1.4;font-weight:500;text-align:center}
  .dy-ans{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .dy-ans button{display:flex;align-items:center;gap:12px;min-height:60px;padding:10px 20px;border-radius:999px;border:2px solid #4B78B8;background:linear-gradient(#183467,#0F2348);color:#FFFFFF;font:inherit;font-size:19px;font-weight:500;text-align:left;cursor:pointer;transition:background .2s,border-color .2s,transform .15s}
  .dy-ans button:hover:not(:disabled){border-color:#F6C451;transform:translateY(-1px)}
  .dy-ans button b{color:#F6C451;font-weight:600}
  .dy-ans button.lock{background:linear-gradient(#F6A623,#C77A0C);border-color:#F6C451;color:#1E1200}
  .dy-ans button.lock b{color:#1E1200}
  .dy-ans button.ok{background:linear-gradient(#3DBA5A,#22843A);border-color:#9BE5A8;animation:dy-blink .45s 3}
  .dy-ans button.bad{background:linear-gradient(#E0454F,#A9232C);border-color:#F3A0A5}
  .dy-ans button:disabled{cursor:default}
  @keyframes dy-blink{50%{filter:brightness(1.35)}}
  .dy-hint{padding:16px 18px;border-radius:16px;background:rgba(246,196,81,.14);border:1px solid rgba(246,196,81,.5);font-size:17px;line-height:1.5;color:#FFF3D1}
  .dy-hint[hidden]{display:none}
  .dy-acts{display:flex;flex-wrap:wrap;gap:10px}
  .dy-stop{min-height:46px;background:rgba(255,255,255,.1);color:#FFFFFF;border:1px solid rgba(255,255,255,.3)}
  .dy-stop:hover{color:#FFFFFF;background:rgba(255,255,255,.18)}
  /* Kömək haqları: istifadə olunmayan parlayır, istifadə olunanın üstündən xətt çəkilir */
  .dy-life{display:flex;align-items:center;flex-wrap:wrap;gap:10px;padding:10px 14px;border-radius:18px;background:rgba(246,196,81,.08);border:1px solid rgba(246,196,81,.28)}
  .dy-life-t{margin-right:auto;font-size:14px;font-weight:600;letter-spacing:.4px;color:#F6C451}
  .dy-ll{position:relative;display:inline-flex;align-items:center;gap:8px;min-height:46px;min-width:96px;justify-content:center;padding:0 18px;border-radius:999px;border:2px solid #F6C451;background:linear-gradient(#24477F,#162E5C);color:#FFFFFF;font:inherit;font-size:16px;font-weight:600;cursor:pointer;animation:dy-glow 2.2s ease-in-out infinite;transition:transform .15s}
  .dy-ll b{font-size:17px;letter-spacing:.5px}
  .dy-ll svg{color:#F6C451}
  .dy-ll:hover:not(:disabled){transform:translateY(-2px)}
  .dy-ll:disabled{cursor:default;animation:none;opacity:.45;border-color:rgba(255,255,255,.35)}
  .dy-ll.used::after{content:'';position:absolute;left:10px;right:10px;top:50%;height:3px;border-radius:3px;background:#E0454F;transform:rotate(-14deg)}
  @keyframes dy-glow{0%,100%{box-shadow:0 0 0 0 rgba(246,196,81,0)}50%{box-shadow:0 0 16px 2px rgba(246,196,81,.55)}}
  .dy-ans button.gone{opacity:.16;pointer-events:none}
  @media (max-width:560px){.dy-life-t{flex-basis:100%}.dy-ll{flex:1}}
  .dy-res{display:flex;flex-direction:column;gap:10px;align-items:flex-start}
  .dy-res h2{margin:0;font-size:30px}
  .dy-res p{margin:0;font-size:18px;line-height:1.5;color:#E6EEF7}
  .dy-acc{margin:14px 0 0;font-size:15px}
  .dy-acc a{color:#F6C451;font-weight:600}
  .dy-prize{display:inline-flex;flex-direction:column;gap:2px;padding:16px 22px;border-radius:18px;background:linear-gradient(#F6C451,#D99A1E);color:#2A1A00}
  .dy-prize b{font-size:26px}
  .dy-ladder{list-style:none;margin:0;padding:12px;border-radius:22px;background:#0F2348;display:flex;flex-direction:column;gap:3px;box-shadow:var(--shadow)}
  .dy-ladder li{display:flex;align-items:center;gap:12px;padding:7px 12px;border-radius:12px;color:#C9D7E8;font-size:15px;transition:background .3s,color .3s}
  .dy-ladder .no{width:24px;text-align:right;font-weight:600;color:#7F9BBF}
  .dy-ladder .t{display:flex;flex-direction:column;line-height:1.2}
  .dy-ladder small{font-size:12px;opacity:.7}
  .dy-ladder li.safe{color:#FFFFFF;font-weight:600}
  .dy-ladder li.safe .no{color:#F6C451}
  .dy-ladder li.won{color:#9BE5A8}
  .dy-ladder li.cur{background:linear-gradient(90deg,#F6A623,#C77A0C);color:#1E1200}
  .dy-ladder li.cur .no{color:#1E1200}
  .xz{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px}
  .xz-i{padding:16px;border-radius:18px;background:#FFFFFF;border:1px solid var(--line);box-shadow:var(--shadow);display:flex;flex-direction:column;gap:4px}
  .xz-i b{font-size:17px}.xz-i span{font-size:13px;color:var(--muted)}
  .xz-i.off{opacity:.35;box-shadow:none}
  .xz-i.off b::after{content:' 🔒';font-size:13px}
  .dy-stat{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}
  .dy-stat span{padding:10px 16px;border-radius:999px;background:#FFFFFF;border:1px solid var(--line);font-size:15px}
  .xz-note,.dy-src{margin:12px 0 0;font-size:14px}
  @media (max-width:960px){.dy{grid-template-columns:minmax(0,1fr)}.dy-ladder{order:-1;flex-direction:row;flex-wrap:wrap}.dy-ladder li{flex:1 1 auto;padding:6px 10px}.dy-ladder small{display:none}}
  @media (max-width:640px){.dy-stage{padding:18px;border-radius:20px}.dy-ans{grid-template-columns:1fr}.dy-q{font-size:20px;padding:16px}}
</style>

<script>
  import { SUALLAR, CATS, IPUCU, PILLELER, QORUNAN } from '../../data/diyar.js';
  import { gonder, cached } from '../../lib/hesab.js';
  import D from '../../data/xerite-data.json';
  import KENDLER from '../../data/kendler.json';

  const $ = (id) => document.getElementById(id);
  const KEY = 'sk-diyar';
  const UNITS = D.U.map((u) => ({ n: u[0], r: u[2], x: u[3], y: u[4] }));
  const unit = (n) => UNITS.find((u) => u.n === n);
  const shuffle = (a) => { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);

  // Yadda saxlanan nəticələr (istifadəçi adı gələnə qədər "qonaq")
  const load = () => { try { return JSON.parse(localStorage.getItem(KEY) || '{}').qonaq || { oyun: 0, enYuksek: 0, hediyye: [] }; } catch { return { oyun: 0, enYuksek: 0, hediyye: [] }; } };
  const save = (s) => { try { localStorage.setItem(KEY, JSON.stringify({ qonaq: s })); } catch { /* yaddaş bağlıdır */ } };

  const N = PILLELER.length; // 15 sual: 5 asan, 5 orta, 5 çətin
  let qs = [], k = 0, helpUsed = false, halfUsed = false, busy = false, cur = null, timer = 0, left = 0, limit = 0;
  // Cavablara sərf olunan vaxt (cavabın açılma animasiyası daxil deyil): eyni pillədəkilər bununla sıralanır
  let qStart = 0, spent = 0, catdi = [0]; // catdi[n]: n düz cavaba çatana qədər sərf olunan vaxt
  // Vaxt: ilk 5 sual 20, növbəti 5 sual 30, son 2 sual 40 saniyə
  const LIMIT = (i) => (i < 5 ? 20 : i < 10 ? 30 : 40);
  const LVL = (i) => (i < 5 ? ['l1', 'Asan'] : i < 10 ? ['l2', 'Orta'] : ['l3', 'Çətin']);
  function tick() {
    $('tm').textContent = Math.ceil(left);
    $('bar').style.transform = `scaleX(${Math.max(0, left / limit)})`;
    const low = left <= 5;
    $('bar').classList.toggle('low', low); $('tm').parentElement.classList.toggle('low', low);
  }
  function startTimer() {
    clearInterval(timer); limit = LIMIT(k); left = limit; tick();
    const t0 = performance.now();
    qStart = t0;
    timer = setInterval(() => {
      left = limit - (performance.now() - t0) / 1000;
      if (left <= 0) { left = 0; tick(); clearInterval(timer); timeUp(); return; }
      if (left <= 5 && Math.ceil(left) !== +$('tm').textContent) tone(880, 0, 0.08, 'sine', 0.05);
      tick();
    }, 200);
  }
  const stopTimer = () => clearInterval(timer);
  function timeUp() {
    if (busy) return;
    busy = true;
    const btns = [...$('ans').querySelectorAll('button')];
    btns.forEach((x) => { x.disabled = true; });
    $('help').disabled = true; $('half').disabled = true;
    btns.find((x) => x.dataset.v === cur.ans).classList.add('ok');
    sBad();
    setTimeout(() => end('time'), 1600);
  }

  // Ses: brauzerin özündə yaradılır
  let ac = null;
  function tone(fr, at, dur, type = 'triangle', vol = 0.12) {
    try {
      ac = ac || new (window.AudioContext || window.webkitAudioContext)();
      const t = ac.currentTime + at, o = ac.createOscillator(), g = ac.createGain();
      o.type = type; o.frequency.value = fr;
      g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(vol, t + 0.02); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      o.connect(g).connect(ac.destination); o.start(t); o.stop(t + dur + 0.05);
    } catch { /* səs dəstəklənmir */ }
  }
  const sOk = () => [523, 659, 784].forEach((f, i) => tone(f, i * 0.1, 0.35));
  const sBad = () => [300, 220].forEach((f, i) => tone(f, i * 0.2, 0.4, 'sawtooth', 0.06));

  // DSK siyahısından təsadüfi kənd və ya qəsəbə (adı ölkədə təkdir, Bakı daxil deyil)
  const RAYONLAR = Object.keys(KENDLER);
  function kendSuali(usedAns) {
    const r = shuffle(RAYONLAR.filter((x) => !usedAns.has(x)))[0];
    const ad = KENDLER[r][Math.floor(Math.random() * KENDLER[r].length)];
    const q = ad.startsWith('q:');
    return ['kend', `${q ? ad.slice(2) : ad} ${q ? 'qəsəbəsi' : 'kəndi'} hansı rayonun ərazisindədir?`, r];
  }
  // Son oyunlarda soruşulan suallar yadda saxlanır ki, yeni oyunda təkrarlanmasın
  const SON = 'sk-diyar-son';
  const sonlar = () => { try { return JSON.parse(localStorage.getItem(SON) || '[]'); } catch { return []; } };
  function build() {
    const son = sonlar();
    // Yaxında soruşulmayan sual ən yaxşısıdır, soruşulanlardan isə ən çoxdan soruşulanı
    const kohne = (q) => { const i = son.indexOf(q[1]); return i < 0 ? 1e9 : i; };
    const pick = [], usedAns = new Set(), catN = {};
    let dsk = 0;
    for (let i = 0; i < N; i++) {
      const lv = i < 5 ? 1 : i < 10 ? 2 : 3;
      // Çətin suallarda DSK siyahısından təsadüfi kənd də soruşulur (oyunda ən çox 2)
      if (lv === 3 && dsk < 2 && Math.random() < 0.4) { const g = kendSuali(usedAns); pick.push(g); usedAns.add(g[2]); dsk++; continue; }
      const prev = pick.length ? pick[pick.length - 1][0] : '';
      // Seçim qaydası: eyni səviyyə, cavab təkrarlanmır, bir kateqoriyadan ən çox 3 sual, ardıcıl eyni kateqoriya yox
      const sert = [
        (q) => q[3] === lv && (catN[q[0]] || 0) < 3 && q[0] !== prev,
        (q) => q[3] === lv && (catN[q[0]] || 0) < 3,
        (q) => q[3] === lv,
        () => true,
      ];
      let q = null;
      for (const f of sert) {
        const c = SUALLAR.filter((x) => f(x) && !usedAns.has(x[2]) && !pick.includes(x));
        if (!c.length) continue;
        const best = Math.max(...c.map(kohne)), top = c.filter((x) => kohne(x) === best);
        q = top[Math.floor(Math.random() * top.length)];
        break;
      }
      pick.push(q); usedAns.add(q[2]); catN[q[0]] = (catN[q[0]] || 0) + 1;
    }
    try { localStorage.setItem(SON, JSON.stringify([...pick.map((q) => q[1]), ...son.filter((t) => !pick.some((q) => q[1] === t))].slice(0, 90))); } catch { /* yaddaş bağlıdır */ }
    return pick;
  }
  // Səhv variantlar düzgün cavaba yaxın ərazilərdən: asanda 7 qonşudan, ortada 5, çətində ən yaxın 3
  function options(ans, lv) {
    const a = unit(ans);
    const near = UNITS.filter((u) => u.n !== ans).sort((p, q) => Math.hypot(p.x - a.x, p.y - a.y) - Math.hypot(q.x - a.x, q.y - a.y)).slice(0, lv === 1 ? 7 : lv === 2 ? 5 : 3);
    return shuffle([ans, ...shuffle(near).slice(0, 3).map((u) => u.n)]);
  }
  function ladder() {
    document.querySelectorAll('#ladder li').forEach((li) => {
      const i = +li.dataset.i;
      li.classList.toggle('won', i < k);
      li.classList.toggle('cur', i === k && !!cur);
    });
  }
  function show() {
    // Rayon olmayan cavablarda variantlar və ipucu sualın özündədir
    const [cat, q, ans, , vars, ipucu] = qs[k];
    cur = { ans, cat, ipucu, opts: vars ? shuffle(vars.slice()) : options(ans, k < 5 ? 1 : k < 10 ? 2 : 3) };
    busy = false;
    $('cat').textContent = CATS[cat];
    $('qn').textContent = k + 1;
    $('q').textContent = q;
    $('ans').innerHTML = cur.opts.map((o, i) => `<button type="button" data-v="${esc(o)}"><b>${'ABCD'[i]}:</b> ${esc(o)}</button>`).join('');
    $('hint').hidden = true;
    $('help').disabled = helpUsed || busy; $('help').classList.toggle('used', helpUsed);
    $('half').disabled = halfUsed || busy; $('half').classList.toggle('used', halfUsed);
    $('stop').disabled = k === 0;
    const [lc, lt] = LVL(k);
    $('lvl').className = 'dy-lvl ' + lc; $('lvl').textContent = lt;
    ladder();
    startTimer();
  }
  const sec = (ms) => { const s = Math.round(ms / 1000), m = Math.floor(s / 60); return m ? `${m} dəqiqə ${s % 60} saniyə` : `${s} saniyə`; };
  function prizeAt(level) { return level > 0 ? PILLELER[level - 1][0] : null; }
  function end(kind) {
    const st = load();
    // Qazanılan pillə: dayananda keçdiyi pillə, səhvdə son qorunan pillə
    stopTimer();
    const level = kind === 'wrong' || kind === 'time' ? Math.max(0, ...QORUNAN.map((q) => q + 1).filter((q) => q <= k)) : k;
    st.oyun++; st.enYuksek = Math.max(st.enYuksek, level);
    for (let i = 0; i < level; i++) if (!st.hediyye.includes(i)) st.hediyye.push(i);
    save(st); xezine();
    // Reytinqə düz cavabların sayı və ona çatma vaxtı gedir (qorunan pillə yox)
    if (k > 0) gonder('diyar', { duz: k, vaxt: Math.round(catdi[k]) });
    const p = prizeAt(level);
    const head = kind === 'win' ? 'Təbriklər, böyük diyarşünas!' : kind === 'stop' ? 'Ağıllı qərar!' : kind === 'time' ? 'Vaxt bitdi.' : 'Təəssüf, cavab səhv oldu.';
    const txt = kind === 'win' ? `Bütün ${N} sualı ${sec(spent)} ərzində doğru cavablandırdın. Azərbaycanı yaxşı tanıyırsan!` : kind === 'stop' ? `${k} suala doğru cavab verib dayandın.` : `Düzgün cavab: <b>${esc(cur.ans)}</b>. ${k} suala doğru cavab verdin.`;
    $('res').innerHTML = `<h2>${head}</h2><p>${txt}</p>` + (p ? `<span class="dy-prize"><span>Qazandığın hədiyyə</span><b>${esc(p)}</b></span>` : '<p>Bu dəfə hədiyyə qazanılmadı, növbəti oyunda mütləq alınacaq.</p>')
      + (cached() ? '' : '<p class="dy-acc">Nəticən reytinqə düşsün deyə <a href="/hesab/qeydiyyat/">qeydiyyatdan keç</a> və ya <a href="/hesab/giris/?geri=/xerite/diyarsunas/">daxil ol</a>.</p>');
    $('play').hidden = true; $('done').hidden = false;
    cur = null; ladder();
  }
  $('ans').addEventListener('click', (e) => {
    const b = e.target.closest('button'); if (!b || busy) return;
    busy = true;
    stopTimer();
    spent += performance.now() - qStart;
    const btns = [...$('ans').querySelectorAll('button')];
    btns.forEach((x) => { x.disabled = true; });
    $('help').disabled = true; $('half').disabled = true;
    b.classList.add('lock');
    tone(440, 0, 0.25, 'sine', 0.06);
    // Qısa gərginlik anı, sonra cavab açılır
    setTimeout(() => {
      const ok = b.dataset.v === cur.ans;
      b.classList.remove('lock');
      btns.find((x) => x.dataset.v === cur.ans).classList.add('ok');
      if (!ok) { b.classList.add('bad'); sBad(); setTimeout(() => end('wrong'), 1600); return; }
      sOk();
      k++;
      catdi[k] = spent;
      setTimeout(() => { if (k === N) end('win'); else show(); }, 1500);
    }, 1200);
  });
  // Bu kateqoriyalarda ərazinin faktı cavabı açır (məs. Şabran: "keçmiş adı Dəvəçidir", Xocalı: soyqırımı), ipucuda yalnız iqtisadi rayon və ilk hərf verilir
  const SADE = new Set(['kohne', 'mehsul', 'hadise']);
  $('help').addEventListener('click', () => {
    if (helpUsed || busy) return;
    helpUsed = true; $('help').disabled = true; $('help').classList.add('used');
    const u = unit(cur.ans);
    $('hint').innerHTML = cur.ipucu ? `<b>İpucu:</b> ${esc(cur.ipucu)}` : `<b>İpucu:</b> Bu ərazi ${esc(u.r)} iqtisadi rayonunda yerləşir. ${esc((!SADE.has(cur.cat) && IPUCU[cur.ans]) || `Rayonun adı "${cur.ans[0]}" hərfi ilə başlayır.`)}`;
    $('hint').hidden = false;
  });
  // 50:50: iki səhv cavab silinir
  $('half').addEventListener('click', () => {
    if (halfUsed || busy) return;
    halfUsed = true; $('half').disabled = true; $('half').classList.add('used');
    const wrong = shuffle([...$('ans').querySelectorAll('button')].filter((x) => x.dataset.v !== cur.ans)).slice(0, 2);
    wrong.forEach((x) => { x.classList.add('gone'); x.disabled = true; x.setAttribute('aria-hidden', 'true'); x.innerHTML = x.querySelector('b').outerHTML; });
    tone(660, 0, 0.15, 'sine', 0.06); tone(990, 0.12, 0.2, 'sine', 0.06);
  });
  $('stop').addEventListener('click', () => { if (!busy && k > 0) end('stop'); });
  function start() {
    qs = build(); k = 0; helpUsed = false; halfUsed = false; spent = 0; catdi = [0];
    $('intro').hidden = true; $('done').hidden = true; $('play').hidden = false;
    show();
    if (ac && ac.state === 'suspended') ac.resume();
  }
  $('start').addEventListener('click', start);
  $('again').addEventListener('click', start);

  function xezine() {
    const st = load();
    $('xn').textContent = st.hediyye.length;
    $('xz').innerHTML = PILLELER.map(([t, d], i) => `<div class="xz-i${st.hediyye.includes(i) ? '' : ' off'}"><b>${esc(t)}</b><span>${i + 1}-ci pillə · ${esc(d)}</span></div>`).join('').replace(/(\d+)-ci pillə/g, (m, n) => `${n}-${({ 3: 'cü', 4: 'cü', 6: 'cı', 9: 'cu', 10: 'cu' })[n] || 'ci'} pillə`);
    $('stat').innerHTML = `<span>Oyun: <b>${st.oyun}</b></span><span>Ən yüksək pillə: <b>${st.enYuksek} / ${N}</b></span><span>Toplanan hədiyyə: <b>${st.hediyye.length} / ${N}</b></span>`;
  }
  document.querySelectorAll('[data-tab]').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('[data-tab]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    $('t-oyun').hidden = b.dataset.tab !== 'oyun';
    $('t-xezine').hidden = b.dataset.tab !== 'xezine';
    $('t-reyt').hidden = b.dataset.tab !== 'reyt';
    if (b.dataset.tab === 'reyt') dispatchEvent(new CustomEvent('sk-reytinq', { detail: 'diyar' })); // cədvəl təzələnir
  }));
  xezine();
</script>
