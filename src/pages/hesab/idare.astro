---
import Base from '../../layouts/Base.astro';
---
<Base title="Hesabların idarəsi" description="Yalnız sayt rəhbərliyi üçün.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <div class="wrap section">
    <section class="stack">
      <h1 class="page-title">Hesabların idarəsi</h1>
      <p class="lead">Şifrəsini unudan istifadəçiyə yeni şifrə vermək, hesabı silmək, reytinqi sıfırlamaq və uyğunsuz adlara baxmaq üçün. İdarəetmə açarı Cloudflare-də ADMIN_KEY kimi saxlanılır.</p>
    </section>
    <form class="card hs" id="f" novalidate>
      <div class="hs-f" style="margin-top:0"><label for="key">İdarəetmə açarı</label><input class="hs-in" id="key" type="password" autocomplete="off" /></div>
      <div class="hs-f"><label for="un">İstifadəçi adı</label><div class="hs-pre"><span>#</span><input class="hs-in" id="un" autocapitalize="none" spellcheck="false" /></div></div>
      <div class="hs-f"><label for="pw">Yeni şifrə</label><input class="hs-in" id="pw" autocomplete="off" /><p class="hs-hint">İstifadəçiyə bu şifrəni bildirin, profilindən özü dəyişə bilər.</p></div>
      <p class="hs-err" id="e" hidden></p>
      <p class="hs-note" id="ok" hidden></p>
      <div class="hs-row">
        <button class="btn btn-p" type="submit">Yeni şifrə ver</button>
        <button class="btn btn-s" type="button" id="del">Hesabı sil</button>
      </div>
      <div class="hs-f" style="margin-top:28px">
        <label for="oyun">Reytinqi sıfırla</label>
        <select class="hs-in" id="oyun">
          <option value="hamisi">Bütün oyunlar</option>
          <option value="xerite">Xəritəni tamamla</option>
          <option value="diyar">Kim diyarşünas olmaq istəyir?</option>
          <option value="sozu">Sözü tap</option>
        </select>
        <p class="hs-hint">Yalnız nəticələr silinir, istifadəçi hesabları qalır.</p>
      </div>
      <div class="hs-row"><button class="btn btn-s" type="button" id="reset">Reytinqi sıfırla</button></div>
    </form>
    <section class="card hs idr-sk">
      <h2>Şikayətlər və uyğunsuz adlar</h2>
      <p class="hs-hint">3 fərqli istifadəçi şikayət edəndə ad reytinqdə avtomatik gizlənir. "Ad dəyişsin" seçilən istifadəçi növbəti girişdə yeni ad seçməli olur.</p>
      <div class="hs-row"><button class="btn btn-p" type="button" id="sk-load">Siyahını göstər</button></div>
      <div id="sk-list" aria-live="polite"></div>
    </section>
  </div>
</Base>

<style is:global>
  .idr-sk{margin-top:20px;max-width:none}
  .idr-sk h2{margin:0 0 6px}
  .idr-a{display:flex;flex-wrap:wrap;gap:6px}
  .idr-a .btn{min-height:34px;padding:0 12px;font-size:14px}
</style>

<script>
  const $ = (id) => document.getElementById(id);
  async function call(path, body) {
    $('e').hidden = true; $('ok').hidden = true;
    const r = await fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Admin-Key': $('key').value }, body: JSON.stringify(body) }).catch(() => null);
    const d = r ? await r.json().catch(() => ({})) : { xeta: 'Serverlə əlaqə alınmadı.' };
    if (!r || !r.ok) { $('e').textContent = d.xeta || 'Xəta'; $('e').hidden = false; return false; }
    return true;
  }
  const un = () => $('un').value.trim().toLowerCase().replace(/^#/, '');
  $('f').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (await call('/api/admin/sifre', { username: un(), yeni: $('pw').value })) { $('ok').textContent = `#${un()} üçün yeni şifrə qoyuldu.`; $('ok').hidden = false; }
  });
  $('reset').addEventListener('click', async () => {
    const ad = $('oyun').selectedOptions[0].textContent;
    if (!confirm(`${ad}: reytinq sıfırlansın? Bu geri qaytarılmır.`)) return;
    const r = await fetch('/api/admin/reytinq', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Admin-Key': $('key').value }, body: JSON.stringify({ oyun: $('oyun').value }) }).catch(() => null);
    const d = r ? await r.json().catch(() => ({})) : {};
    if (!r || !r.ok) { $('e').textContent = d.xeta || 'Serverlə əlaqə alınmadı.'; $('e').hidden = false; $('ok').hidden = true; return; }
    $('e').hidden = true; $('ok').textContent = `${ad}: reytinq sıfırlandı (${d.silinen} nəticə silindi).`; $('ok').hidden = false;
  });
  // Şikayətlər: siyahı və moderasiya əmrləri
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  async function admin(path, body) {
    const r = await fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Admin-Key': $('key').value }, body: JSON.stringify(body) }).catch(() => null);
    const d = r ? await r.json().catch(() => ({})) : {};
    if (!r || !r.ok) throw new Error(d.xeta || 'Serverlə əlaqə alınmadı.');
    return d;
  }
  async function skList() {
    const box = $('sk-list');
    box.innerHTML = '<p class="hs-hint">Yüklənir...</p>';
    try {
      const { siyahi } = await admin('/api/admin/sikayetler', {});
      if (!siyahi.length) { box.innerHTML = '<p class="hs-note">Şikayət yoxdur.</p>'; return; }
      const veziyyet = (x) => [x.bagli && 'bağlanıb', x.ad_deyis && 'ad dəyişməlidir', x.gizli && !x.ad_deyis && 'gizlədilib', x.filtr && 'filtrdən keçmir'].filter(Boolean).join(', ') || 'aktiv';
      box.innerHTML = `<table class="rt-tbl idr-t"><thead><tr><th>İstifadəçi</th><th>Şikayət</th><th>Vəziyyət</th><th></th></tr></thead><tbody>${siyahi.map((x) => `<tr>
        <td><b>${esc(x.ad)}</b> <span class="un">#${esc(x.username)}</span></td><td>${x.say}</td><td>${veziyyet(x)}</td>
        <td class="idr-a"><button type="button" class="btn btn-s" data-emr="temiz" data-u="${esc(x.username)}">Təmizdir</button>
        <button type="button" class="btn btn-s" data-emr="ad-deyis" data-u="${esc(x.username)}">Ad dəyişsin</button>
        <button type="button" class="btn btn-s" data-emr="${x.bagli ? 'ac' : 'bagla'}" data-u="${esc(x.username)}">${x.bagli ? 'Aç' : 'Bağla'}</button></td></tr>`).join('')}</tbody></table>`;
    } catch (e) { box.innerHTML = `<p class="hs-err">${esc(e.message)}</p>`; }
  }
  $('sk-load').addEventListener('click', skList);
  $('sk-list').addEventListener('click', async (e) => {
    const b = e.target.closest('[data-emr]'); if (!b) return;
    if (b.dataset.emr === 'bagla' && !confirm(`#${b.dataset.u} hesabı bağlansın?`)) return;
    try { await admin('/api/admin/moderasiya', { username: b.dataset.u, emr: b.dataset.emr }); skList(); } catch (x) { alert(x.message); }
  });
  $('del').addEventListener('click', async () => {
    if (!un() || !confirm(`#${un()} hesabı və bütün nəticələri silinsin?`)) return;
    if (await call('/api/admin/sil', { username: un() })) { $('ok').textContent = `#${un()} hesabı silindi.`; $('ok').hidden = false; }
  });
</script>
