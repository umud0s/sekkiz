---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import AT from '../../data/gen/atalar.json';
import { fmt } from '../../lib/search.js';
// Axtarış motorları üçün ilk 24 atalar sözü HTML-də hazır gəlir, qalanı brauzerdə yüklənir
const first = AT.slice(0, 24);
---
<Base title="Atalar sözləri" description={`${fmt(AT.length)} Azərbaycan atalar sözü, hər birinin izahı ilə. Mövzu və hərf üzrə axtarış.`}>
  <div class="wrap section">
    <section class="stack">
      <nav class="crumbs" aria-label="Yol"><a href="/">Ana səhifə</a> <span aria-hidden="true">/</span> Atalar sözləri</nav>
      <h1 class="page-title">Atalar sözləri</h1>
      <p class="lead">Xalqın əsrlər boyu topladığı hikmət: {fmt(AT.length)} atalar sözü, hər birinin izahı ilə.</p>
      <a class="btn btn-p" href="/atalar-sozleri/quiz/" style="align-self:flex-start">Quiz: gizli sözü tap →</a>
    </section>

    <section class="day" aria-label="Günün atalar sözü">
      <svg class="day-star" width="220" height="220" viewBox="-104 -104 208 208" aria-hidden="true"><polygon points="0,-100 29.29,-70.71 70.71,-70.71 70.71,-29.29 100,0 70.71,29.29 70.71,70.71 29.29,70.71 0,100 -29.29,70.71 -70.71,70.71 -70.71,29.29 -100,0 -70.71,-29.29 -70.71,-70.71 -29.29,-70.71" fill="#FFFFFF" /></svg>
      <span class="day-l" id="dayL">Günün atalar sözü</span>
      <a class="day-q" id="dayQ" href={`/atalar-sozleri/${AT[0].s}/`}>{AT[0].t}</a>
      <p class="day-m" id="dayM">{AT[0].m}</p>
      <div class="day-b">
        <button type="button" class="btn" id="dayNext" style="background:#FFFFFF;color:var(--accent)">Başqasını göstər</button>
        <button type="button" class="btn day-o" id="dayCopy">Kopyala</button>
        <a class="btn day-o" id="dayWa" href="#" target="_blank" rel="noopener">WhatsApp-da paylaş</a>
      </div>
    </section>

    <section class="stack" aria-label="Axtarış">
      <div class="search">
        <label for="q" class="sr-only">Atalar sözlərində axtar</label>
        <Icon name="search" />
        <input id="q" type="search" autocomplete="off" placeholder="Söz və ya mövzu yazın: dost, iş, səbr…" />
      </div>
      <div class="opts">
        <label class="tg"><input type="checkbox" id="loose" checked /> <span>Azərbaycan hərfləri olmadan da tap <span class="muted">(seher → səhər)</span></span></label>
        <div class="chips" role="group" aria-label="Sıralama"><span class="muted">Sırala:</span> <button type="button" class="chip" data-sort="az" aria-pressed="true">Əlifba üzrə</button><button type="button" class="chip" data-sort="rnd" aria-pressed="false">Qarışıq</button></div>
      </div>
      <div class="chips" id="topics" role="group" aria-label="Mövzular"></div>
      <div class="letters" id="letters" role="group" aria-label="Hərf üzrə"></div>
    </section>

    <section class="stack" aria-label="Nəticələr">
      <p id="count" class="lead" style="font-size:17px" aria-live="polite">{fmt(AT.length)} atalar sözü</p>
      <div class="grid-2" id="list">
        {first.map((p) => (
          <article class="card pv">
            <a class="pv-t" href={`/atalar-sozleri/${p.s}/`}>{p.t}</a>
            <div><span class="pv-l">Mənası</span><p>{p.m}</p></div>
          </article>
        ))}
      </div>
      <div class="empty" id="empty" hidden><p style="margin:0 0 8px;font-size:20px;font-weight:500">Bu axtarışa uyğun atalar sözü tapılmadı</p><p class="muted" style="margin:0">Sözün kökünü yazmağa çalışın: "dostluq" əvəzinə "dost".</p></div>
      <button type="button" class="btn btn-s" id="more" style="align-self:center" hidden>Daha çox göstər</button>
    </section>

    <section class="card tg-cta">
      <div class="stack" style="gap:6px;max-width:640px">
        <h2 style="margin:0;font-size:24px;font-weight:500">Atalar sözləri Telegram-da</h2>
        <p class="muted" style="margin:0;font-size:16px;line-height:1.5">Botumuz hər gün bir atalar sözü göndərir, bəyəndiklərinizi yadda saxlayır və öyrəndiklərinizin hesabını aparır. Kanalımızda isə hər gün yeni atalar sözü paylaşılır.</p>
      </div>
      <div class="chips">
        <a class="btn btn-s" href="https://t.me/atalarimizinsozu" target="_blank" rel="noopener">Kanala qoşul</a>
        <a class="btn btn-p" href="https://t.me/AtalarSozleri_bot" target="_blank" rel="noopener"><Icon name="telegram" size={20} /> Bota keç</a>
      </div>
    </section>
    <p class="muted" style="margin:0;font-size:14px">Mənbə: “Atalar sözü”, Öndər nəşriyyat, 2004.</p>
  </div>
</Base>

<style is:global>
  .chips{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .day{position:relative;overflow:hidden;padding:34px 40px;border-radius:22px;background:var(--accent);color:#FFFFFF;box-shadow:0 18px 40px -16px rgba(5,50,80,.55);display:flex;flex-direction:column;gap:14px}
  .day-star{position:absolute;right:-50px;top:-50px;opacity:.1}
  .day-l{font-size:14px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;opacity:.85}
  .day-q{font-size:32px;font-weight:500;line-height:1.25;max-width:820px;color:#FFFFFF;text-decoration:none}
  .day-q:hover{color:#FFFFFF;text-decoration:underline}
  .day-m{margin:0;font-size:18px;line-height:1.5;max-width:760px;opacity:.92}
  .day-b{display:flex;flex-wrap:wrap;gap:10px;padding-top:6px}
  .day-o{background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,.5);font-weight:500}
  .day-o:hover{color:#FFFFFF}
  .opts{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px}
  .tg{display:flex;align-items:center;gap:10px;cursor:pointer;font-size:15px}
  .tg input{width:20px;height:20px;accent-color:var(--accent)}
  .pv{display:flex;flex-direction:column;gap:12px;padding:24px;transition:transform .3s cubic-bezier(.2,.8,.2,1),box-shadow .3s}
  .pv:hover{transform:translateY(-4px);box-shadow:var(--shadow-hi)}
  .pv-t{font-size:22px;font-weight:500;line-height:1.3;color:var(--ink);text-decoration:none}
  .pv-t:hover{color:var(--accent)}
  .pv p{margin:4px 0 0;font-size:16px;line-height:1.5;color:var(--ink-2)}
  .pv-l{font-size:13px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--accent)}
  .pv-f{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;padding-top:8px;border-top:1px solid #E6EDF2}
  .tag-b{min-height:32px;padding:0 12px;border-radius:999px;border:0;background:#E6F0F6;color:#0A5A80;font:inherit;font-size:14px;cursor:pointer}
  .act{display:inline-flex;align-items:center;min-height:38px;padding:0 12px;border-radius:10px;border:0;background:#EEF4F8;color:var(--accent);font:inherit;font-size:15px;font-weight:500;cursor:pointer;text-decoration:none}
  .act:hover{background:var(--accent);color:#FFFFFF}
  .tg-cta{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:18px;padding:26px 30px}
  @media (max-width:860px){.day{padding:26px 22px}.day-q{font-size:26px}}
</style>

<script>
  import { norm, esc, highlight, ALPHA, firstLetter, fmt } from '../../lib/search.js';

  const $ = (id) => document.getElementById(id);
  const params = new URLSearchParams(location.search);
  const S = { q: params.get('q') || '', topic: params.get('movzu') || null, letter: null, sort: 'az', loose: true, limit: 12, seed: 1, dayShift: 0 };
  let ALL = [];
  const shareText = (p) => `${p.t}\n\n${p.m}\n\nSəkkizguşə · Atalar sözləri`;
  const url = (p) => `${location.origin}/atalar-sozleri/${p.s}/`;
  const wa = (p) => 'https://wa.me/?text=' + encodeURIComponent(shareText(p) + '\n' + url(p));
  const tg = (p) => 'https://t.me/share/url?url=' + encodeURIComponent(url(p)) + '&text=' + encodeURIComponent(shareText(p));
  async function copy(text, btn) {
    try { await navigator.clipboard.writeText(text); } catch (e) { /* köhnə brauzer */ }
    const o = btn.textContent; btn.textContent = 'Kopyalandı'; setTimeout(() => { btn.textContent = o; }, 1800);
  }

  function filtered() {
    const nq = norm(S.q.trim(), S.loose);
    let list = ALL.filter((p) => (!S.topic || p.tp.includes(S.topic)) && (!S.letter || p.first === S.letter) && (!nq || (S.loose ? p.hl : p.hs).includes(nq)));
    if (S.sort === 'rnd') list = list.slice().sort((a, b) => ((a.id * 9301 + S.seed * 49297) % 233280) - ((b.id * 9301 + S.seed * 49297) % 233280));
    return { list, nq };
  }
  function renderList() {
    const { list, nq } = filtered();
    $('list').innerHTML = list.slice(0, S.limit).map((p) => `
      <article class="card pv">
        <a class="pv-t" href="/atalar-sozleri/${p.s}/">${highlight(p.t, nq, S.loose)}</a>
        <div><span class="pv-l">Mənası</span><p>${highlight(p.m, nq, S.loose)}</p></div>
        <div class="pv-f">
          <div class="chips">${p.tp.map((t) => `<button type="button" class="tag-b" data-topic="${esc(t)}">${esc(t)}</button>`).join('')}</div>
          <div class="chips"><button type="button" class="act" data-copy="${p.id}">Kopyala</button><a class="act" href="${wa(p)}" target="_blank" rel="noopener">WhatsApp</a><a class="act" href="${tg(p)}" target="_blank" rel="noopener">Telegram</a></div>
        </div>
      </article>`).join('');
    const has = S.q || S.topic || S.letter;
    $('count').textContent = (has ? 'Tapıldı: ' : '') + fmt(list.length) + ' atalar sözü' + (S.topic ? ' · ' + S.topic : '') + (S.letter ? ` · "${S.letter}" hərfi` : '');
    $('empty').hidden = list.length !== 0;
    $('more').hidden = list.length <= S.limit;
    $('more').textContent = `Daha çox göstər (${fmt(list.length - S.limit)} qalıb)`;
    document.querySelectorAll('#topics .chip').forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.topic || null) === S.topic)));
    document.querySelectorAll('#letters button').forEach((b) => b.setAttribute('aria-pressed', String(b.textContent === S.letter)));
    document.querySelectorAll('[data-sort]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.sort === S.sort)));
  }
  function renderDay() {
    const p = ALL[(Math.floor(Date.now() / 86400000) * 7919 + S.dayShift) % ALL.length];
    $('dayL').textContent = S.dayShift ? 'Təsadüfi atalar sözü' : 'Günün atalar sözü';
    $('dayQ').textContent = p.t; $('dayQ').href = `/atalar-sozleri/${p.s}/`;
    $('dayM').textContent = p.m; $('dayWa').href = wa(p);
    $('dayCopy').onclick = (e) => copy(shareText(p), e.currentTarget);
  }
  function setup() {
    const tc = {}, lc = {};
    ALL.forEach((p) => { p.tp.forEach((t) => { tc[t] = (tc[t] || 0) + 1; }); lc[p.first] = (lc[p.first] || 0) + 1; });
    $('topics').innerHTML = `<button type="button" class="chip" data-topic="">Hamısı <span class="n">${fmt(ALL.length)}</span></button>` +
      Object.keys(tc).sort((a, b) => tc[b] - tc[a]).map((t) => `<button type="button" class="chip" data-topic="${esc(t)}">${esc(t)} <span class="n">${tc[t]}</span></button>`).join('');
    $('letters').innerHTML = ALPHA.map((ch) => `<button type="button" ${lc[ch] ? '' : 'disabled'} aria-label="${ch} hərfi ilə başlayanlar${lc[ch] ? ': ' + lc[ch] : ' (yoxdur)'}">${ch}</button>`).join('');
  }

  $('q').value = S.q;
  $('q').addEventListener('input', (e) => { S.q = e.target.value; S.limit = 12; renderList(); });
  $('loose').addEventListener('change', (e) => { S.loose = e.target.checked; renderList(); });
  $('more').addEventListener('click', () => { S.limit += 12; renderList(); });
  $('dayNext').addEventListener('click', () => { S.dayShift += 1 + Math.floor(Math.random() * 3000); renderDay(); });
  document.addEventListener('click', (e) => {
    const t = e.target.closest('[data-topic]');
    if (t) { const v = t.dataset.topic || null; S.topic = t.classList.contains('chip') && S.topic === v ? null : v; S.limit = 12; renderList(); return; }
    const l = e.target.closest('#letters button');
    if (l) { S.letter = S.letter === l.textContent ? null : l.textContent; S.limit = 12; renderList(); return; }
    const s = e.target.closest('[data-sort]');
    if (s) { S.sort = s.dataset.sort; S.seed++; renderList(); return; }
    const c = e.target.closest('[data-copy]');
    if (c) { const p = ALL.find((x) => x.id === +c.dataset.copy); copy(shareText(p), c); }
  });

  fetch('/data/atalar.json').then((r) => r.json()).then((rows) => {
    ALL = rows.map((p) => ({ ...p, first: firstLetter(p.t), hs: norm(`${p.t} ${p.m} ${p.tp.join(' ')}`, false), hl: norm(`${p.t} ${p.m} ${p.tp.join(' ')}`, true) }));
    setup(); renderDay(); renderList();
  });
</script>
