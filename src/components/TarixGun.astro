---
import '../styles/tarix-ikon.css';
import { dayHTML, monthHTML, calHTML, dateTitle, key, MONTH_TITLES, BY_DAY } from '../lib/tarix.js';

// day: [ay, gün] — ayrıca gün səhifəsində verilir; əsas səhifədə boşdur və bu günü brauzer seçir
const { day = null } = Astro.props;
const k = day ? key(day[0], day[1]) : '';
const n = day && BY_DAY[k] ? BY_DAY[k].length : 0;
---
<div class="tg" id="tg" data-day={k}>
  <div class="tg-main">
    <div class="card tg-head">
      <button type="button" class="tg-arr" data-step="-1" aria-label="Əvvəlki gün">‹</button>
      <div class="tg-title">
        <span class="tg-kick" id="tg-kick">{day ? (n ? `${n} hadisə` : 'Seçilmiş gün') : 'Bu gün'}</span>
        <h2 id="tg-date">{day ? dateTitle(day[0], day[1]) : ''}</h2>
      </div>
      <button type="button" class="tg-arr" data-step="1" aria-label="Növbəti gün">›</button>
    </div>
    <div class="card tg-day" id="tg-day" aria-live="polite">
      {day ? <Fragment set:html={dayHTML(day[0], day[1])} /> : <noscript><p>Təqvimi görmək üçün brauzerdə JavaScript aktiv olmalıdır.</p></noscript>}
    </div>
  </div>
  <aside class="card tg-cal">
    <div class="tg-cal-h">
      <button type="button" class="tg-arr sm" data-mstep="-1" aria-label="Əvvəlki ay">‹</button>
      <b id="cal-m">{day ? MONTH_TITLES[day[0] - 1] : ''}</b>
      <button type="button" class="tg-arr sm" data-mstep="1" aria-label="Növbəti ay">›</button>
    </div>
    <div class="tg-grid" id="cal" role="group" aria-label="Ayın günləri">{day && <Fragment set:html={calHTML(day[0], k, '')} />}</div>
    <p class="tg-leg"><i></i> hadisə qeyd olunan günlər</p>
    <button type="button" class="chip" id="tg-today">Bu günə qayıt</button>
  </aside>
</div>
<section class="tg-month">
  <h2 id="mo-h">{day ? `${MONTH_TITLES[day[0] - 1]} ayında` : ''}</h2>
  <div class="card" id="mo">{day && <Fragment set:html={monthHTML(day[0])} />}</div>
</section>

<style is:global>
  .tg{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(0,1fr);gap:24px;align-items:start}
  .tg-main{display:flex;flex-direction:column;gap:16px;min-width:0}
  .tg-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 22px}
  .tg-title{text-align:center;display:flex;flex-direction:column;gap:2px}
  .tg-kick{font-size:14px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--accent)}
  .tg-title h2{margin:0;font-size:40px;font-weight:500;line-height:1.1}
  .tg-arr{flex:none;width:48px;height:48px;border-radius:14px;border:1px solid var(--line);background:#FFFFFF;font:inherit;font-size:28px;line-height:1;color:var(--accent);cursor:pointer;transition:background .2s,color .2s}
  .tg-arr:hover{background:var(--accent);color:#FFFFFF}
  .tg-arr.sm{width:38px;height:38px;font-size:22px;border-radius:11px}
  .tg-day{padding:28px}

  .tg-empty{display:flex;flex-direction:column;gap:12px}
  .tg-empty p{margin:0;font-size:18px;line-height:1.5}
  .tg-near-h{font-size:14px;font-weight:600;color:var(--muted)}
  .tg-near{display:flex;flex-wrap:wrap;gap:8px}

  .tg-cal{padding:20px;display:flex;flex-direction:column;gap:14px;position:sticky;top:16px}
  .tg-cal-h{display:flex;align-items:center;justify-content:space-between}
  .tg-cal-h b{font-size:20px;font-weight:600}
  .tg-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px}
  .tg-grid button{position:relative;aspect-ratio:1;border:0;border-radius:10px;background:#F2F6F9;font:inherit;font-size:15px;color:var(--muted);cursor:pointer;transition:background .2s,color .2s}
  .tg-grid button.has{background:#E2F0F7;color:var(--ink);font-weight:600}
  .tg-grid button.has::after{content:'';position:absolute;left:50%;bottom:5px;width:5px;height:5px;margin-left:-2.5px;border-radius:50%;background:#EF3340}
  .tg-grid button:hover{background:#CFE5F1}
  .tg-grid button.today{box-shadow:inset 0 0 0 2px var(--accent)}
  .tg-grid button.sel{background:var(--accent);color:#FFFFFF}
  .tg-grid button.sel::after{background:#FFFFFF}
  .tg-leg{margin:0;font-size:14px;color:var(--muted);display:flex;align-items:center;gap:8px}
  .tg-leg i{width:7px;height:7px;border-radius:50%;background:#EF3340}
  #tg-today{align-self:flex-start}

  .tg-month{display:flex;flex-direction:column;gap:14px}
  .tg-month h2{align-self:flex-start;margin:0;padding:10px 20px;border-radius:999px;background:#FFFFFF;border:1px solid var(--line);box-shadow:0 6px 16px -10px rgba(10,50,80,.4);font-size:22px;font-weight:500}
  #mo{padding:8px}
  .mo{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2px 12px}
  .mo-i{width:100%;display:grid;grid-template-columns:auto minmax(0,1fr);grid-template-rows:auto auto;column-gap:14px;align-items:center;padding:10px 12px;border:0;border-radius:12px;background:transparent;font:inherit;text-align:left;color:var(--ink);cursor:pointer;transition:background .2s}
  .mo-i:hover{background:#F0F6FA}
  .mo-i .ti{grid-row:span 2}
  .mo-d{font-size:14px;color:var(--muted)}
  .mo-t{font-size:16px;font-weight:500;line-height:1.3}


  @media (max-width:960px){
    .tg{grid-template-columns:minmax(0,1fr)}
    .tg-cal{position:static}
    .mo{grid-template-columns:minmax(0,1fr)}
  }
  @media (max-width:640px){
    .tg-head{padding:14px}
    .tg-title h2{font-size:30px}
    .tg-day{padding:20px}
    .tl-i{gap:14px}
    .tl-y{font-size:24px}
    .tl-b h3{font-size:19px}
    .tl-b p{font-size:16px}
  }
</style>

<script>
  import { dayHTML, monthHTML, calHTML, dateTitle, key, slug, fromSlug, MONTH_TITLES, DAYS_IN, BY_DAY } from '../lib/tarix.js';

  const root = document.getElementById('tg');
  const $ = (id) => document.getElementById(id);
  const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Baku', month: 'numeric', day: 'numeric' }).formatToParts(new Date());
  const TODAY = [+parts.find((p) => p.type === 'month').value, +parts.find((p) => p.type === 'day').value];
  const todayK = key(...TODAY);

  let [m, d] = root.dataset.day ? root.dataset.day.split('-').map(Number) : (fromSlug(decodeURIComponent(location.hash.slice(1))) || TODAY);
  let calM = m;

  function show(push) {
    const k = key(m, d), ev = BY_DAY[k];
    $('tg-date').textContent = dateTitle(m, d);
    $('tg-kick').textContent = k === todayK ? 'Bu gün' : ev ? `${ev.length} hadisə` : 'Seçilmiş gün';
    $('tg-day').innerHTML = dayHTML(m, d);
    calM = m;
    cal();
    $('mo-h').textContent = `${MONTH_TITLES[m - 1]} ayında`;
    $('mo').innerHTML = monthHTML(m);
    document.title = `${dateTitle(m, d)}: Azərbaycan tarixində bu gün — Səkkizguşə`;
    if ($('tg-h1')) { $('tg-h1').textContent = `Azərbaycan tarixində ${dateTitle(m, d)}`; $('tg-crumb').textContent = dateTitle(m, d); }
    if (push) history.replaceState(null, '', ev ? `/tarix/bu-gun/${slug(m, d)}/` : `/tarix/bu-gun/#${slug(m, d)}`);
  }
  function cal() {
    $('cal-m').textContent = MONTH_TITLES[calM - 1];
    $('cal').innerHTML = calHTML(calM, key(m, d), todayK);
  }
  function go(k) { [m, d] = k.split('-').map(Number); show(true); }
  function step(n) {
    d += n;
    if (d < 1) { m = m === 1 ? 12 : m - 1; d = DAYS_IN[m - 1]; }
    if (d > DAYS_IN[m - 1]) { m = m === 12 ? 1 : m + 1; d = 1; }
    show(true);
  }

  document.addEventListener('click', (e) => {
    const g = e.target.closest('[data-go]');
    if (g) { go(g.dataset.go); if (g.closest('#mo, .tg-near')) $('tg').scrollIntoView({ behavior: 'smooth', block: 'start' }); return; }
    const s = e.target.closest('[data-step]');
    if (s) { step(+s.dataset.step); return; }
    const ms = e.target.closest('[data-mstep]');
    if (ms) { calM = ((calM - 1 + +ms.dataset.mstep + 12) % 12) + 1; cal(); }
  });
  $('tg-today').addEventListener('click', () => { [m, d] = TODAY; show(true); });
  document.addEventListener('keydown', (e) => {
    if (e.target.closest('input, textarea')) return;
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });
  show(false);
</script>
