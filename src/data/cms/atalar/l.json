{
  "herf": "L",
  "sozler": [
    {
      "id": 2730,
      "metn": "Laçın balasın verməz, bəlkə zorla alarlar.",
      "izah": "Güclü adam doğmasını könüllü vermir.",
      "movzular": [
        "Ailə"
      ]
    },
    {
      "id": 2731,
      "metn": "Laçın qalada balalar.",
      "izah": "Güclü adam övladını təhlükəsiz yerdə böyüdür.",
      "movzular": [
        "Ailə"
      ]
    },
    {
      "id": 2732,
      "metn": "Lahıcı sel apardı, elə deyirdi: qiblə pakdı.",
      "izah": "Böyük itki içində xırda şeylə təsəlli tapır.",
      "movzular": [
        "El"
      ]
    },
    {
      "id": 2733,
      "metn": "Laxlayan daş ərkdə qalmaz.",
      "izah": "Yerində möhkəm durmayan tezliklə düşür.",
      "movzular": [
        "Əxlaq"
      ]
    },
    {
      "id": 2734,
      "metn": "Lalın dilini anası bilər.",
      "izah": "Danışa bilməyənin dərdini anası anlayır.",
      "movzular": [
        "Ailə",
        "Dil və söz"
      ]
    },
    {
      "id": 2735,
      "metn": "Laylayı bilirsən, niyə yatmırsan?",
      "izah": "Başqasına məsləhət verirsən, bəs özün niyə əməl etmirsən?",
      "movzular": [
        "Nəsihət"
      ]
    },
    {
      "id": 2736,
      "metn": "Leş görəndə qarğa quzğuna dönər.",
      "izah": "Mənfəət görəndə adamın tamahı artır.",
      "movzular": [
        "Tamah"
      ]
    },
    {
      "id": 2737,
      "metn": "Lələ köçüb, yurdu qalıb.",
      "izah": "Sahibi getsə də, onun izi qalır.",
      "movzular": [
        "El"
      ]
    },
    {
      "id": 2738,
      "metn": "Lənət heçə.",
      "izah": "Heç nəyə yaramayan şeydən imtina etmək lazımdır.",
      "movzular": [
        "Nəsihət"
      ]
    },
    {
      "id": 2741,
      "metn": "Loxma qarın doyurmaz, məhəbbət artırar.",
      "izah": "Kiçik hədiyyə ehtiyacı ödəməsə də, sevgini artırır.",
      "movzular": [
        "Qonaqpərvərlik"
      ]
    },
    {
      "id": 2742,
      "metn": "Lotu lotunu tapmasa, qara geyər, yaslı olar.",
      "izah": "Tayını tapmayan adam darıxır.",
      "movzular": [
        "Dostluq"
      ]
    },
    {
      "id": 2743,
      "metn": "Lotu lotunun sözünə inanar.",
      "izah": "Eyni xasiyyətli adamlar bir-birinə inanır.",
      "movzular": [
        "Ağıl",
        "Dil və söz"
      ]
    },
    {
      "id": 2744,
      "metn": "Lotuluq tərg götürməz.",
      "izah": "İgidlik qorxu bilmir.",
      "movzular": [
        "Nəsihət"
      ]
    },
    {
      "id": 2745,
      "metn": "Löyünsüzə böyüklük eləmək olmaz.",
      "izah": "Layiq olmayan adama hörmət göstərmək faydasızdır.",
      "movzular": [
        "Əxlaq"
      ]
    },
    {
      "id": 2746,
      "metn": "Lüleyin aftafa yerin tutar, girov qoyanda — alan olmaz.",
      "izah": "Kiçik şey böyük şeyin yerini tutsa da, dəyəri ona çatmır.",
      "movzular": [
        "Nəsihət"
      ]
    },
    {
      "id": 2747,
      "metn": "Lütün dərdi olmaz.",
      "izah": "Heç nəyi olmayanın itirməyə də heç nəyi yoxdur.",
      "movzular": [
        "Dərd və səbr"
      ]
    },
    {
      "id": 2748,
      "metn": "Lütdən kəsən harda yeyəcək?!",
      "izah": "Kasıbdan pay qoparan adam heç nə qazanmır.",
      "movzular": [
        "Nəsihət"
      ]
    }
  ]
}
