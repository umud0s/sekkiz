{
  "herf": "F",
  "sozler": [
    {
      "id": 1628,
      "metn": "Fağırın düşgünü, al geyinər qış günü.",
      "izah": "Kasıb adam çətin vaxtda da özünü göstərməyə çalışır.",
      "movzular": [
        "Var-dövlət"
      ]
    },
    {
      "id": 1629,
      "metn": "Fala inanma, falsız da qalma.",
      "izah": "Hər şeyə kor-koranə inanma, amma tamamilə də rədd etmə.",
      "movzular": [
        "Ağıl"
      ]
    },
    {
      "id": 1630,
      "metn": "Falçı falçıya fənd vurmaz.",
      "izah": "Eyni peşədən olanlar bir-birini aldatmır.",
      "movzular": [
        "İş"
      ]
    },
    {
      "id": 1631,
      "metn": "Fələk bağlar, fələk açar.",
      "izah": "Taleyin özü çətinlik yaradır, özü də aradan qaldırır.",
      "movzular": [
        "Dərd və səbr"
      ]
    },
    {
      "id": 1632,
      "metn": "Fələk güclü, mən gücsüz.",
      "izah": "Tale qarşısında insan acizdir.",
      "movzular": [
        "Dərd və səbr"
      ]
    },
    {
      "id": 1633,
      "metn": "Fələk yıxmayanı kələk yıxar.",
      "izah": "Taledən qurtulan hiyləyə düşür.",
      "movzular": [
        "Dərd və səbr"
      ]
    },
    {
      "id": 1634,
      "metn": "Fələyin bir çuval qızılı var, hər gün birinin çiynindədir.",
      "izah": "Var-dövlət bir gün birində, bir gün digərində olur.",
      "movzular": [
        "Var-dövlət"
      ]
    },
    {
      "id": 1635,
      "metn": "Fələyin gözü kordu.",
      "izah": "Tale kimin layiq olduğunu görmür.",
      "movzular": [
        "Dərd və səbr"
      ]
    },
    {
      "id": 1636,
      "metn": "Fələyin qaydasıdı, dağı çəkər dağ üstdən.",
      "izah": "Bir dərdin üstünə başqası gəlir.",
      "movzular": [
        "Dərd və səbr"
      ]
    },
    {
      "id": 1637,
      "metn": "Fənd fəndi kəsər, Allah hər ikisin.",
      "izah": "Hiyləni hiylə məğlub edir, ilahi ədalət isə hər ikisini cəzalandırır.",
      "movzular": [
        "Haqq və ədalət"
      ]
    },
    {
      "id": 1638,
      "metn": "Fərhad ölüb, külüngünün səsi gəlmir.",
      "izah": "Zəhmətkeş insan getdi, iş dayandı.",
      "movzular": [
        "Nəsihət"
      ]
    },
    {
      "id": 1639,
      "metn": "Fərsiz qoyunu qurd yeyər.",
      "izah": "Bacarıqsız, zəif adam bəlaya düşür.",
      "movzular": [
        "Dərd və səbr"
      ]
    },
    {
      "id": 1640,
      "metn": "Fərsiz oğul atasının gözün çıxartdı ki, adına Koroğlu desinlər, amma kor kişinin oğlu dedilər.",
      "izah": "Layiq olmayan adam şöhrət qazanmağa çalışarkən rüsvay olur.",
      "movzular": [
        "Ailə"
      ]
    },
    {
      "id": 1641,
      "metn": "Filin bir fikri var, filbanın min.",
      "izah": "Bir nəfər bir şey düşünür, onu idarə edən isə çox şey düşünür.",
      "movzular": [
        "Ağıl"
      ]
    },
    {
      "id": 1642,
      "metn": "Fitə uyanın evi yıxılar.",
      "izah": "Başqasının fitnəsinə uyan adamın ailəsi dağılır.",
      "movzular": [
        "Ailə"
      ]
    },
    {
      "id": 1643,
      "metn": "Fit-fitnən gələn köpəyin qoyuna faydası olmaz.",
      "izah": "Məcburiyyətlə görülən işin xeyri olmur.",
      "movzular": [
        "Nəsihət"
      ]
    },
    {
      "id": 1644,
      "metn": "Fuğaranın gözü tox olar.",
      "izah": "Əsl kasıbın gözü toxdur.",
      "movzular": [
        "Bərəkət",
        "Var-dövlət"
      ]
    }
  ]
}
