// Cloudflare Workers ayarları: sayt statik fayllardan ibarətdir (dist qovluğu)
{
  "name": "sekkizguse",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // Olmayan səhifədə saytın öz 404 səhifəsi göstərilir
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
